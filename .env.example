# ─────────────────────────────────────────────────────────────────────────────
# CMT Realtors — environment
#
# Copy to .env.local and fill in. Nothing here is a secret; .env.local is.
#
# Every value below is server-only by design. There is deliberately no
# browser-facing database or storage key: the app reaches Postgres and the
# bucket from the server, through src/lib/data and src/lib/storage, and
# nothing else opens a connection. See docs/PORTABILITY.md.
#
# The app runs with none of this set. Absent DATABASE_URL it reads the static
# content in src/data/*.ts, which is exactly what it does today, so the build
# never depends on a backend being reachable.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────
# Any Postgres. Supabase, Neon, RDS, a container on a laptop.
DATABASE_URL=

# Serverless opens a connection per invocation and will exhaust the direct
# limit, so give it the pooled string where the host offers one. Falls back to
# DATABASE_URL when empty, which is right for local work.
DATABASE_POOL_URL=


# ── Object storage ───────────────────────────────────────────────────────────
# Any S3-compatible bucket: Supabase Storage, Cloudflare R2, Backblaze B2,
# MinIO, S3 itself. Swapping vendors is these five lines and nothing else.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where uploaded files are publicly served from. A CDN hostname in production,
# the bucket's own public URL otherwise. This is the origin that has to be
# allowlisted in next.config.ts before next/image will touch it.
S3_PUBLIC_URL=


# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session cookies. 32 bytes minimum.
#   openssl rand -base64 32
AUTH_SECRET=

# Full origin, used for cookie scope and password reset links.
AUTH_URL=http://localhost:3000


# ── Email ────────────────────────────────────────────────────────────────────
# SMTP rather than a vendor SDK, so the provider stays swappable. Whichever it
# is, SPF, DKIM and DMARC have to be set on the sending domain or enquiry
# alerts land in spam and nobody notices for weeks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender, and where enquiry notifications go.
MAIL_FROM="CMT Realtors <noreply@cmtrealtors.com>"
MAIL_TO=


# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Used by metadataBase, the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
